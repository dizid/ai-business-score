{
  "name": "aivis-web",
  "private": true,
  "type": "module",
  "description": "AIVis hosted site — Vite + TypeScript + Vue 3 frontend, plus Netlify Functions runtime deps. `npm run build` produces dist (published by Netlify CI); Netlify's esbuild bundler resolves netlify/functions/* independently from node_modules at deploy time.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/build-blog.mjs",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@netlify/blobs": "^8.2.0",
    "better-auth": "^1.4.18",
    "jose": "^5.9.6",
    "stripe": "^22.4.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@netlify/vite-plugin": "^2.1.1",
    "@tailwindcss/vite": "^4.1.0",
    "@tsconfig/node18": "^18.2.4",
    "@types/node": "^18.19.39",
    "@vitejs/plugin-vue": "^5.2.1",
    "marked": "^18.0.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.10"
  }
}
