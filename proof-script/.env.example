# Used as the gateway for openai/gpt-5-mini if OPENAI_API_KEY (below) isn't
# set. See shared/aivis-core.mjs's callModel comment for the full migration
# story.
PERPLEXITY_API_KEY=

# anthropic/*, google/*, xai/*, and openai/* models each call their own
# provider's API directly instead of going through Perplexity, whenever the
# matching key below is set. Any of these left blank just means that
# model's calls fail and get counted as failures (or, for openai
# specifically, fall back to the Perplexity gateway above), same as any
# other call error.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
