# Only needed for openai/gpt-5-mini, which has no direct provider key
# available and still routes through Perplexity's gateway. See
# shared/aivis-core.mjs's callModel comment for the full migration story.
PERPLEXITY_API_KEY=

# anthropic/*, google/*, and xai/* models now call each provider's own API
# directly instead of going through Perplexity. Any of these left blank
# just means that model's calls fail and get counted as failures, same as
# any other call error.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
